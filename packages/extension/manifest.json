{
  "manifest_version": 3,
  "name": "Slop Filter",
  "version": "0.1.0",
  "description": "Detect synthetic-narrated slop in YouTube videos.",
  "permissions": ["storage", "activeTab", "scripting", "tabCapture"],
  "host_permissions": ["https://www.youtube.com/*", "https://example.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Slop Filter",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
